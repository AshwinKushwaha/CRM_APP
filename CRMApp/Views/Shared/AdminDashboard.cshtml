@model CRMApp.ViewModels.ActivityLogViewModel;
@{
	ViewData["Title"] = "AdminDashboard";
	Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<!-- Responsive Dashboard Layout -->
<div class="row g-3">
	<!-- Main Content (Left Side - 8 columns on desktop) -->
	<div class="col-lg-8 col-md-12">
		<!-- Website Visits Chart Section -->
		<div class="card shadow-sm mb-4">
			<div class="card-body">
				<h3 class="mb-4">Website Visits (Last 30 Days)</h3>
				<div class="row g-3 mb-4">
					<div class="col-lg-4 col-md-4 col-sm-12">
						<div class="card bg-primary text-white">
							<div class="card-body text-center">
								<div style="font-size: 1.5rem;">??</div>
								<small>Today</small>
								<h4 class="mb-0">@ViewBag.VisitsToday</h4>
							</div>
						</div>
					</div>
					<div class="col-lg-4 col-md-4 col-sm-12">
						<div class="card bg-success text-white">
							<div class="card-body text-center">
								<div style="font-size: 1.5rem;">??</div>
								<small>This Week</small>
								<h4 class="mb-0">@ViewBag.VisitsThisWeek</h4>
							</div>
						</div>
					</div>
					<div class="col-lg-4 col-md-4 col-sm-12">
						<div class="card bg-info text-white">
							<div class="card-body text-center">
								<div style="font-size: 1.5rem;">??</div>
								<small>This Month</small>
								<h4 class="mb-0">@ViewBag.VisitsThisMonth</h4>
							</div>
						</div>
					</div>
				</div>
				<div style="position: relative; height: 300px;">
					<canvas id="visitsChart"></canvas>
				</div>
			</div>
		</div>

		<!-- Overview Section -->
		<div class="card shadow-sm mb-4">
			<div class="card-body">
				<h3 class="mb-4">Overview</h3>
				<div class="row g-3">
					<div class="col-lg-4 col-md-6 col-sm-12">
						<div class="card dashboard-stat-card" id="user-tile" style="cursor: pointer;">
							<div class="card-body text-center">
								<div style="font-size: 2rem; margin-bottom: 0.5rem;">??</div>
								<h5>Total Users</h5>
								<p class="h3 mb-0 text-primary">@ViewBag.UserCount</p>
							</div>
						</div>
					</div>
					<div class="col-lg-4 col-md-6 col-sm-12">
						<div class="card dashboard-stat-card" id="customer-tile" style="cursor: pointer;">
							<div class="card-body text-center">
								<div style="font-size: 2rem; margin-bottom: 0.5rem;">??</div>
								<h5>Total Customers</h5>
								<p class="h3 mb-0 text-primary">@ViewBag.CustomerCount</p>
							</div>
						</div>
					</div>
					<div class="col-lg-4 col-md-6 col-sm-12">
						<div class="card dashboard-stat-card" id="contact-tile" style="cursor: pointer;">
							<div class="card-body text-center">
								<div style="font-size: 2rem; margin-bottom: 0.5rem;">??</div>
								<h5>Total Contacts</h5>
								<p class="h3 mb-0 text-primary">@ViewBag.ContactCount</p>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>

		<!-- Enquiries Section -->
		<div class="card shadow-sm">
			<div class="card-body">
				<div class="d-flex justify-content-between align-items-center mb-3">
					<h3 class="mb-0">Recent Enquiries</h3>
					<a class="text-decoration-none" asp-action="Index" asp-controller="ContactInquiry">
						View all <i class="bi bi-arrow-right"></i>
					</a>
				</div>
				<div class="row g-3">
					@foreach(var item in Model.contactInquiries)
					{
						<div class="col-lg-6 col-md-6 col-sm-12">
							<div class="card enquiry-card" data-email="@item.Email" data-name="@item.Name" 
								 data-timeStamp="@item.CreatedAt" data-EnquiryMessage="@item.Message" 
								 data-bs-toggle="modal" data-bs-target="#detailModal" style="cursor: pointer;">
								<div class="card-body">
									<p class="mb-2"><strong>Name:</strong> @item.Name</p>
									<p class="mb-2"><strong>Email:</strong> @item.Email</p>
									<p class="mb-0 text-muted small">
										<strong>Date:</strong> @Model.FormatDate(item.CreatedAt) at @item.CreatedAt.ToString("h:mm tt")
									</p>
								</div>
							</div>
						</div>
					}
				</div>
			</div>
		</div>
	</div>

	<!-- Activity Feed (Right Side - 4 columns on desktop, full width on mobile) -->
	<div class="col-lg-4 col-md-12">
		<div class="card shadow-sm sticky-top" style="top: 6rem; max-height: calc(100vh - 8rem); overflow-y: auto;">
			<div class="card-body">
				<h3 class="mb-4">Activity Feed</h3>
				@if (Model.activityLogs.Count == 0)
				{
					<div class="text-center text-muted py-5">
						<div style="font-size: 3rem; opacity: 0.3;">??</div>
						<p>No Activity To Show</p>
					</div>
				}
				else
				{
					<div class="activity-feed">
						@foreach (var item in Model.activityLogs)
						{
							<div class="activity-item mb-3">
								<div class="card">
									<div class="card-body p-3">
										<h6 class="mb-2">@item.ModuleId</h6>
										<p class="mb-1 @((bool)item.IsDeleted ? "text-danger" : "text-success")">
											@item.Action
										</p>
										<small class="text-muted">
											@Model.FormatDate(item.TimeStamp) at @item.TimeStamp.ToString("h:mm tt")
										</small>
									</div>
								</div>
							</div>
						}
						<!-- Pagination -->
						@if (Model.activityLogs.TotalPages > 1)
						{
							<nav class="mt-3">
								<ul class="pagination pagination-sm justify-content-center">
									@if (Model.activityLogs.HasPreviousPage)
									{
										<li class="page-item">
											<a class="page-link" href="?pageIndex=@(Model.activityLogs.PageIndex - 1)">Previous</a>
										</li>
									}
									@for(int i = Model.activityLogs.StartPage; i <= Model.activityLogs.EndPage; i++)
									{
										<li class="page-item @(i == Model.activityLogs.PageIndex ? "active" : "")">
											<a href="?pageIndex=@i" class="page-link">@i</a>
										</li>
									}
									@if (Model.activityLogs.HasNextPage)
									{
										<li class="page-item">
											<a href="?pageIndex=@(Model.activityLogs.PageIndex + 1)" class="page-link">Next</a>
										</li>
									}
								</ul>
							</nav>
						}
					</div>
				}
			</div>
		</div>
	</div>
</div>

<!-- Enquiry Detail Modal -->
<div class="modal fade" tabindex="-1" id="detailModal" aria-hidden="true">
	<div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
		<div class="modal-content">
			<div class="modal-header">
				<h5 class="modal-title">Enquiry Details</h5>
				<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
			</div>
			<div class="modal-body">
				<p><strong>Name:</strong> <span id="name"></span></p>
				<p><strong>Email:</strong> <span id="email"></span></p>
				<p><strong>Time:</strong> <span id="timeStamp"></span></p>
				<p><strong>Message:</strong></p>
				<p id="EnquiryMessage" class="text-muted"></p>
			</div>
			<div class="modal-footer">
				<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
			</div>
		</div>
	</div>
</div>

@section Scripts {
	<!-- Chart.js CDN -->
	<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
	
	<script>
		$(document).ready(function() {
			// Initialize Visits Chart
			const visitStatsData = @Html.Raw(ViewBag.DailyVisitStats ?? "[]");
			
			if (visitStatsData && visitStatsData.length > 0) {
				const ctx = document.getElementById('visitsChart');
				
				const labels = visitStatsData.map(item => item.Date);
				const data = visitStatsData.map(item => item.VisitCount);
				
				new Chart(ctx, {
					type: 'line',
					data: {
						labels: labels,
						datasets: [{
							label: 'Daily Visits',
							data: data,
							borderColor: '#2563eb',
							backgroundColor: 'rgba(37, 99, 235, 0.1)',
							borderWidth: 2,
							fill: true,
							tension: 0.4,
							pointRadius: 3,
							pointHoverRadius: 5,
							pointBackgroundColor: '#2563eb',
							pointBorderColor: '#fff',
							pointBorderWidth: 2
						}]
					},
					options: {
						responsive: true,
						maintainAspectRatio: false,
						plugins: {
							legend: {
								display: true,
								position: 'top',
							},
							tooltip: {
								mode: 'index',
								intersect: false,
								backgroundColor: 'rgba(0, 0, 0, 0.8)',
								titleColor: '#fff',
								bodyColor: '#fff',
								borderColor: '#2563eb',
								borderWidth: 1,
								padding: 12,
								displayColors: true,
								callbacks: {
									label: function(context) {
										return 'Visits: ' + context.parsed.y;
									}
								}
							}
						},
						scales: {
							y: {
								beginAtZero: true,
								ticks: {
									stepSize: 1,
									color: '#64748b'
								},
								grid: {
									color: 'rgba(0, 0, 0, 0.05)'
								}
							},
							x: {
								ticks: {
									color: '#64748b',
									maxRotation: 45,
									minRotation: 45
								},
								grid: {
									display: false
								}
							}
						},
						interaction: {
							mode: 'nearest',
							axis: 'x',
							intersect: false
						}
					}
				});
			}

			// Click handlers for stat cards
			$("#customer-tile").click(function () {
				window.location.href = "/Customer/Index";
			});

			$("#contact-tile").click(function() {
				window.location.href = "/Contact/Index";
			});

			$("#user-tile").click(function(){
				window.location.href = "/User/Index";
			});

			// Modal handler for enquiry cards
			$(".enquiry-card").on('click', function(){
				var name = $(this).data("name");
				var email = $(this).data("email");
				var timeStamp = $(this).data("timestamp");
				var message = $(this).data("enquirymessage");

				$('#name').text(name);
				$('#email').text(email);
				$('#timeStamp').text(timeStamp);
				$('#EnquiryMessage').text(message).css('white-space', 'pre-line');
			});
		});
	</script>
}
