
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/crm_main.css" asp-append-version="true" />
    <title>@ViewBag.Title</title>
</head>
<body>
    <!-- Responsive Navbar -->
    <nav class="navbar navbar-expand-lg navbar-light sticky-top" style="top: 0.5rem; z-index: 1000; margin: 0.5rem;">
        <div class="container-fluid">
            <div class="d-flex align-items-center">
                <span class="navbar-brand mb-0 me-2">Welcome</span>
                <strong class="text-primary d-none d-sm-inline">@await Component.InvokeAsync("User")</strong>
            </div>
            
            <!-- Mobile Toggle Button -->
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#adminNavbar" 
                    aria-controls="adminNavbar" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            
            <!-- Collapsible Content -->
            <div class="collapse navbar-collapse" id="adminNavbar">
                <div class="ms-auto mt-2 mt-lg-0">
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </div>
    </nav>
    
    <div class="container" style="margin-top: 1rem; min-height: calc(100vh - 150px);">
        @RenderBody()
    </div>
   
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/Script.js"></script>
    <script type="text/javascript">
        $(document).ready(function() {
            // Highlight active nav link
            var currentUrl = window.location.pathname.toLowerCase();
            $('.btn-primary, .btn-secondary').not('.dropdown-toggle').each(function() {
                var linkUrl = $(this).attr('href');
                if (linkUrl && currentUrl.includes(linkUrl.toLowerCase())) {
                    $(this).removeClass('btn-secondary').addClass('btn-primary');
                }
            });
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
