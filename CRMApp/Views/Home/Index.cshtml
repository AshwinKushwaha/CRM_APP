@model CRMApp.Models.ContactInquiry;
@{
    ViewData["Title"] = "Home";
    Layout = "_Layout";
}

<!-- Hero Section -->
<section class="hero text-center text-white">
    <h1>Streamline Your Customer Relationships</h1>
    <p class="mb-4">Manage contacts, track interactions, and grow your business efficiently with our powerful CRM solution.</p>
    <a href="Identity/Account/Login" class="btn btn-secondary btn-lg">Get Started</a>
</section>

<!-- Features Section -->
<section id="features" class="py-5">
    <h2 class="text-center mb-5">Key Features</h2>
    <div class="features-grid">
        <div class="card feature-card">
            <div style="font-size: 2.5rem; margin-bottom: 1rem;">📋</div>
            <h4>Contact Management</h4>
            <p>Store and organize customer details with powerful search and filter options.</p>
        </div>
        <div class="card feature-card">
            <div style="font-size: 2.5rem; margin-bottom: 1rem;">📝</div>
            <h4>Notes & Activity Logs</h4>
            <p>Keep track of all interactions with time-stamped notes for each customer.</p>
        </div>
        <div class="card feature-card">
            <div style="font-size: 2.5rem; margin-bottom: 1rem;">🔒</div>
            <h4>Role-Based Access</h4>
            <p>Secure your data with admin, sales, and support roles tailored to your team.</p>
        </div>
    </div>
</section>

<!-- Benefits Section -->
<section id="benefits" class="card py-5">
    <div class="text-center px-4">
        <h2 class="mb-3">Why Choose CRMApp?</h2>
        <p class="text-muted mb-4">Our CRM is designed to be simple, fast, and scalable for growing businesses.</p>
        <div class="d-flex flex-column align-items-center gap-2">
            <div class="d-flex align-items-center gap-2">
                <span style="color: #10b981; font-size: 1.5rem;">✓</span>
                <span>Easy to use interface</span>
            </div>
            <div class="d-flex align-items-center gap-2">
                <span style="color: #10b981; font-size: 1.5rem;">✓</span>
                <span>Real-time updates and filtering</span>
            </div>
            <div class="d-flex align-items-center gap-2">
                <span style="color: #10b981; font-size: 1.5rem;">✓</span>
                <span>Secure and scalable architecture</span>
            </div>
        </div>
    </div>
</section>

<!-- Contact Form Section -->
<section id="contact" class="card py-5">
    <div class="px-4">
        <h2 class="text-center mb-4">Get in Touch</h2>
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <form asp-action="SaveInquiry" asp-controller="ContactInquiry" id="contactForm" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <div class="form-group">
                        <label asp-for="Name" class="form-label">Your Name</label>
                        <input asp-for="Name" class="form-control" placeholder="Enter your name" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="Email" class="form-label">Your Email</label>
                        <input asp-for="Email" class="form-control" placeholder="Enter your email" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="Message" class="form-label">Your Message</label>
                        <textarea asp-for="Message" class="form-control" rows="5" placeholder="Tell us how we can help you"></textarea>
                        <span asp-validation-for="Message" class="text-danger"></span>
                    </div>
                    <button type="submit" class="btn btn-primary">Send Message</button>
                </form>
            </div>
        </div>
    </div>
</section>

<!-- Toast Notification -->
<div class="position-fixed top-0 end-0 p-3" style="z-index: 1050">
    <div id="messageToast" class="toast align-items-center text-bg-success border-0" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="d-flex">
            <div class="toast-body">
                Your message has been sent successfully!
            </div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
        </div>
    </div>
</div>

@section Scripts{
<script>
    $(document).ready(function () {
        $('#contactForm').on('submit', function (e) {
            e.preventDefault();

            $.ajax({
                type: 'POST',
                url: $(this).attr('action'),
                data: $(this).serialize(),
                success: function (response) {
                    var toastEl = document.getElementById('messageToast');
                    var toast = new bootstrap.Toast(toastEl);
                    toast.show();
                    $('#contactForm')[0].reset();
                },
                error: function () {
                    alert('Something went wrong. Please try again.');
                }
            });
        });
    });
</script>
}

